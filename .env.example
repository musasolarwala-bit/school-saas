# School Manager SaaS — environment variables
# Copy to .env for local runs. Never commit a real .env.

# PostgreSQL connection string. Local test example:
# DATABASE_URL=postgres://postgres:bf_local_test@127.0.0.1:5432/school_saas_test
DATABASE_URL=

# Long random secret used to sign JWTs. Generate one per deployment
# (Render's render.yaml generates one automatically). Never reuse the
# test value below in production.
JWT_SECRET=change-me-to-a-long-random-secret

# Port the web service listens on (Render sets PORT automatically).
PORT=3000
